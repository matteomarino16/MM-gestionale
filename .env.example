# Copia questo file in .env e sostituisci i valori. Non committare mai .env.

# ── Database ──────────────────────────────────────────────
# Genera una password con: openssl rand -hex 24
DATABASE_URL="postgresql://gestionale:CAMBIAMI@localhost:5432/gestionale?schema=public"
# Database separato per i test (verrà svuotato dai test!). Il nome deve contenere "test".
TEST_DATABASE_URL="postgresql://gestionale:CAMBIAMI@localhost:5432/gestionale_test?schema=public"

# Solo se usi docker-compose.yml
POSTGRES_USER="gestionale"
POSTGRES_PASSWORD="CAMBIAMI"
POSTGRES_DB="gestionale"

# ── Applicazione ──────────────────────────────────────────
APP_URL="http://localhost:3000"
APP_TIMEZONE="Europe/Rome"
SESSION_IDLE_HOURS=168
SESSION_ABSOLUTE_DAYS=30
# auto = Secure quando APP_URL è https
COOKIE_SECURE="auto"
# true solo dietro un reverse proxy fidato che imposta X-Forwarded-For
TRUST_PROXY="false"

# ── Promemoria (cron) ─────────────────────────────────────
# Segreto per l'endpoint /api/cron/reminders, usato dal cron di Vercel.
# Genera con: openssl rand -hex 32
CRON_SECRET=""

# ── File ──────────────────────────────────────────────────
UPLOAD_DIR="./storage/documents"
BACKUP_DIR="./backups"

# ── Web Push (fase 6) ─────────────────────────────────────
# Genera con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tu@esempio.it"
