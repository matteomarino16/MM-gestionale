// Schema del gestionale MM.
//
// Convenzioni:
// - Importi: Decimal(12,2). Aliquote: Decimal(5,2). Mai Float per il denaro.
// - Date civili (scadenze, date di pagamento): @db.Date, interpretate come
//   data di calendario senza conversioni di fuso.
// - Istanti: @db.Timestamptz(3).
// - I dati economici non si cancellano: le relazioni finanziarie usano
//   onDelete: Restrict; clienti e servizi si archiviano/annullano.
// - Vincoli non esprimibili in Prisma (CHECK, indici parziali, trigram)
//   sono nella migrazione SQL "constraints".

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Utenti e sicurezza ───────────────────────────────

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  lastLoginAt  DateTime? @db.Timestamptz(3)

  sessions          Session[]
  preference        UserPreference?
  pushSubscriptions PushSubscription[]
  notifications     Notification[]
  auditLogs         AuditLog[]
}

/// Sessione server-side. L'id è lo SHA-256 del token presente nel cookie:
/// un dump del database non permette di impersonare l'utente.
model Session {
  id                String   @id
  userId            String   @db.Uuid
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt        DateTime @default(now()) @db.Timestamptz(3)
  expiresAt         DateTime @db.Timestamptz(3)
  /// Limite assoluto oltre il quale la sessione non viene più prorogata.
  absoluteExpiresAt DateTime @db.Timestamptz(3)
  ip                String?
  userAgent         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Tentativi di login, usati per il rate limiting persistente.
model LoginAttempt {
  id          BigInt   @id @default(autoincrement())
  email       String
  ip          String
  success     Boolean
  attemptedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([email, attemptedAt])
  @@index([ip, attemptedAt])
}

model UserPreference {
  userId                 String  @id @db.Uuid
  timezone               String  @default("Europe/Rome")
  /// Ora locale (HH:MM) in cui vengono emessi i promemoria.
  reminderTime           String  @default("09:00")
  dashboardNotifications Boolean @default(true)
  pushNotifications      Boolean @default(true)
  theme                  Theme   @default(SYSTEM)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Theme {
  SYSTEM
  LIGHT
  DARK
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  summary    String?
  data       Json?
  ip         String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─────────────────────────────── Anagrafiche ───────────────────────────────

enum ClientType {
  PERSON
  COMPANY
  OTHER
}

enum ClientStatus {
  ACTIVE
  ARCHIVED
}

model Client {
  id             String       @id @default(uuid(7)) @db.Uuid
  type           ClientType   @default(PERSON)
  firstName      String?
  lastName       String?
  companyName    String?
  /// Nome visualizzato calcolato lato server (ragione sociale o nome e cognome).
  displayName    String
  vatNumber      String?
  taxCode        String?
  email          String?
  phone          String?
  pec            String?
  address        String?
  postalCode     String?
  city           String?
  province       String?
  country        String       @default("IT")
  billingAddress String?
  notes          String?
  status         ClientStatus @default(ACTIVE)
  archivedAt     DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  services      Service[]
  projects      Project[]
  quotes        Quote[]
  receivables   Receivable[]
  tasks         Task[]
  documents     Document[]
  notifications Notification[]

  @@index([status])
  @@index([displayName])
}

model Provider {
  id         String   @id @default(uuid(7)) @db.Uuid
  name       String   @unique
  website    String?
  email      String?
  phone      String?
  accountRef String?
  notes      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  services Service[]
  payables Payable[]
}

// ─────────────────────────────── Servizi e rinnovi ───────────────────────────────

enum ServiceType {
  DOMAIN_REGISTRATION
  DOMAIN_RENEWAL
  HOSTING
  VPS_SERVER
  PEC
  EMAIL
  SSL_CERTIFICATE
  SOFTWARE_LICENSE
  PLUGIN_THEME
  WEBSITE
  LANDING_PAGE
  ECOMMERCE
  MOBILE_APP
  MAINTENANCE
  SUPPORT
  SEO_DIGITAL
  CONSULTING
  OTHER
}

enum ServiceStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum RenewalFrequency {
  NONE
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  BIENNIAL
  CUSTOM
}

enum IntervalUnit {
  DAY
  MONTH
}

model Service {
  id                  String           @id @default(uuid(7)) @db.Uuid
  clientId            String           @db.Uuid
  providerId          String?          @db.Uuid
  name                String
  type                ServiceType
  description         String?
  /// Dominio o hostname di riferimento, se applicabile (ricerca globale).
  domain              String?
  providerRef         String?
  startDate           DateTime?        @db.Date
  /// Scadenza corrente (coincide con la scadenza del ciclo di rinnovo aperto).
  expiryDate          DateTime?        @db.Date
  frequency           RenewalFrequency @default(ANNUAL)
  customIntervalValue Int?
  customIntervalUnit  IntervalUnit?
  providerCost        Decimal          @default(0) @db.Decimal(12, 2)
  clientPrice         Decimal          @default(0) @db.Decimal(12, 2)
  currency            String           @default("EUR") @db.Char(3)
  vatRate             Decimal          @default(22) @db.Decimal(5, 2)
  status              ServiceStatus    @default(ACTIVE)
  autoRenew           Boolean          @default(false)
  /// Fuso IANA con cui interpretare le date civili del servizio.
  timezone            String           @default("Europe/Rome")
  notes               String?
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(3)

  client        Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  provider      Provider?        @relation(fields: [providerId], references: [id], onDelete: Restrict)
  renewals      ServiceRenewal[]
  receivables   Receivable[]
  payables      Payable[]
  tasks         Task[]
  documents     Document[]
  notifications Notification[]

  @@index([clientId])
  @@index([status, expiryDate])
}

enum RenewalStatus {
  /// Rinnovo previsto, nessuna azione ancora intrapresa.
  PLANNED
  /// Il fornitore deve essere pagato.
  PROVIDER_PAYMENT_DUE
  /// Il pagamento è stato richiesto al cliente.
  CLIENT_REQUESTED
  /// Il cliente ha pagato (il servizio NON è per questo rinnovato).
  CLIENT_PAID
  /// Il fornitore è stato pagato.
  PROVIDER_PAID
  /// Rinnovo effettuato presso il fornitore e confermato esplicitamente.
  COMPLETED
  CANCELLED
}

/// Ciclo di rinnovo. I cicli completati restano come storico; al completamento
/// viene creato il ciclo successivo senza modificare quello precedente.
model ServiceRenewal {
  id                   String        @id @default(uuid(7)) @db.Uuid
  serviceId            String        @db.Uuid
  cycleNumber          Int
  /// Scadenza del ciclo (data civile).
  expiryDate           DateTime      @db.Date
  plannedRenewalDate   DateTime?     @db.Date
  expectedProviderCost Decimal       @default(0) @db.Decimal(12, 2)
  actualProviderCost   Decimal?      @db.Decimal(12, 2)
  clientPrice          Decimal       @default(0) @db.Decimal(12, 2)
  status               RenewalStatus @default(PLANNED)
  renewedAt            DateTime?     @db.Date
  newExpiryDate        DateTime?     @db.Date
  /// Incrementata a ogni modifica della scadenza: invalida i promemoria obsoleti.
  deadlineRevision     Int           @default(1)
  notes                String?
  cancelledAt          DateTime?     @db.Timestamptz(3)
  createdAt            DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(3)

  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  receivables   Receivable[]
  payables      Payable[]
  documents     Document[]
  notifications Notification[]

  @@unique([serviceId, cycleNumber])
  @@index([status, expiryDate])
}

// ─────────────────────────────── Commesse, preventivi, attività ───────────────────────────────

enum ProjectStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id           String        @id @default(uuid(7)) @db.Uuid
  clientId     String        @db.Uuid
  title        String
  description  String?
  status       ProjectStatus @default(OPEN)
  agreedAmount Decimal?      @db.Decimal(12, 2)
  startDate    DateTime?     @db.Date
  dueDate      DateTime?     @db.Date
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)

  client      Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  quotes      Quote[]
  receivables Receivable[]
  payables    Payable[]
  tasks       Task[]
  documents   Document[]

  @@index([clientId])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quote {
  id          String      @id @default(uuid(7)) @db.Uuid
  clientId    String      @db.Uuid
  projectId   String?     @db.Uuid
  number      String      @unique
  title       String
  description String?
  netAmount   Decimal     @db.Decimal(12, 2)
  vatRate     Decimal     @default(22) @db.Decimal(5, 2)
  status      QuoteStatus @default(DRAFT)
  issuedOn    DateTime?   @db.Date
  validUntil  DateTime?   @db.Date
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([clientId])
}

model Task {
  id          String    @id @default(uuid(7)) @db.Uuid
  title       String
  description String?
  dueDate     DateTime? @db.Date
  completedAt DateTime? @db.Timestamptz(3)
  clientId    String?   @db.Uuid
  projectId   String?   @db.Uuid
  serviceId   String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  client  Client?  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([completedAt, dueDate])
}

// ─────────────────────────────── Registro economico ───────────────────────────────

/// Stato memorizzato; "scaduto" è derivato (dueDate passata e stato OPEN/PARTIAL).
enum SettlementStatus {
  OPEN
  PARTIAL
  PAID
  CANCELLED
}

/// Credito verso un cliente (entrata).
/// amountDue = netAmount + vatAmount - withholdingAmount (calcolato sul server).
model Receivable {
  id                String           @id @default(uuid(7)) @db.Uuid
  clientId          String           @db.Uuid
  serviceId         String?          @db.Uuid
  renewalId         String?          @db.Uuid
  projectId         String?          @db.Uuid
  description       String
  /// Importo concordato (imponibile).
  netAmount         Decimal          @db.Decimal(12, 2)
  vatRate           Decimal          @default(0) @db.Decimal(5, 2)
  vatAmount         Decimal          @default(0) @db.Decimal(12, 2)
  withholdingRate   Decimal          @default(0) @db.Decimal(5, 2)
  withholdingAmount Decimal          @default(0) @db.Decimal(12, 2)
  /// Importo che il cliente deve effettivamente versare.
  amountDue         Decimal          @db.Decimal(12, 2)
  /// Somma dei pagamenti non stornati (denormalizzata, aggiornata in transazione).
  paidAmount        Decimal          @default(0) @db.Decimal(12, 2)
  currency          String           @default("EUR") @db.Char(3)
  dueDate           DateTime?        @db.Date
  timezone          String           @default("Europe/Rome")
  deadlineRevision  Int              @default(1)
  status            SettlementStatus @default(OPEN)
  cancelledAt       DateTime?        @db.Timestamptz(3)
  notes             String?
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)

  client        Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  service       Service?        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  renewal       ServiceRenewal? @relation(fields: [renewalId], references: [id], onDelete: Restrict)
  project       Project?        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  payments      Payment[]
  documents     Document[]
  notifications Notification[]

  @@index([clientId])
  @@index([status, dueDate])
  @@index([renewalId])
}

model ExpenseCategory {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  payables Payable[]
}

/// Debito verso un fornitore (uscita).
/// amountDue = (actualAmount ?? expectedAmount) + vatAmount (calcolato sul server).
model Payable {
  id             String           @id @default(uuid(7)) @db.Uuid
  providerId     String?          @db.Uuid
  serviceId      String?          @db.Uuid
  renewalId      String?          @db.Uuid
  projectId      String?          @db.Uuid
  categoryId     String?          @db.Uuid
  description    String
  /// Imponibile previsto.
  expectedAmount Decimal          @db.Decimal(12, 2)
  /// Imponibile effettivo (noto a consuntivo).
  actualAmount   Decimal?         @db.Decimal(12, 2)
  vatRate        Decimal          @default(0) @db.Decimal(5, 2)
  vatAmount      Decimal          @default(0) @db.Decimal(12, 2)
  amountDue      Decimal          @db.Decimal(12, 2)
  paidAmount     Decimal          @default(0) @db.Decimal(12, 2)
  currency       String           @default("EUR") @db.Char(3)
  dueDate        DateTime?        @db.Date
  status         SettlementStatus @default(OPEN)
  cancelledAt    DateTime?        @db.Timestamptz(3)
  notes          String?
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  provider  Provider?        @relation(fields: [providerId], references: [id], onDelete: Restrict)
  service   Service?         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  renewal   ServiceRenewal?  @relation(fields: [renewalId], references: [id], onDelete: Restrict)
  project   Project?         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  category  ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  payments  Payment[]
  documents Document[]

  @@index([providerId])
  @@index([status, dueDate])
  @@index([renewalId])
}

enum PaymentDirection {
  IN
  OUT
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
  PAYPAL
  STRIPE
  CHECK
  DIRECT_DEBIT
  OTHER
}

/// Movimento di cassa. Non si cancella: un errore si corregge con uno storno
/// (voidedAt), che esclude il movimento dai totali conservandone la traccia.
model Payment {
  id           String           @id @default(uuid(7)) @db.Uuid
  direction    PaymentDirection
  receivableId String?          @db.Uuid
  payableId    String?          @db.Uuid
  amount       Decimal          @db.Decimal(12, 2)
  currency     String           @default("EUR") @db.Char(3)
  paidOn       DateTime         @db.Date
  method       PaymentMethod    @default(BANK_TRANSFER)
  reference    String?
  notes        String?
  voidedAt     DateTime?        @db.Timestamptz(3)
  voidReason   String?
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)

  receivable Receivable? @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  payable    Payable?    @relation(fields: [payableId], references: [id], onDelete: Restrict)
  documents  Document[]

  @@index([receivableId])
  @@index([payableId])
  @@index([paidOn])
}

// ─────────────────────────────── Promemoria e notifiche ───────────────────────────────

enum ReminderTarget {
  RENEWAL
  RECEIVABLE
}

enum NotificationChannel {
  DASHBOARD
  PUSH
}

/// Regola di promemoria. offsetDays è relativo alla scadenza in giorni di
/// calendario locale (negativo = prima, 0 = giorno stesso, positivo = dopo).
/// repeatEveryDays, se valorizzato, ripete l'avviso finché la risorsa è aperta.
model ReminderRule {
  id              String                @id @default(uuid(7)) @db.Uuid
  /// Identificativo stabile usato nelle chiavi di idempotenza (es. "30d").
  key             String
  target          ReminderTarget
  label           String
  offsetDays      Int
  repeatEveryDays Int?
  maxRepeats      Int?
  channels        NotificationChannel[] @default([DASHBOARD, PUSH])
  enabled         Boolean               @default(true)
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(3)

  events ReminderEvent[]

  @@unique([target, key])
}

enum ReminderEventStatus {
  PENDING
  PROCESSING
  DONE
  CANCELLED
  FAILED
}

/// Outbox/coda persistente dei promemoria. Una riga per (risorsa, revisione
/// della scadenza, regola, occorrenza, canale): la dedupeKey UNIQUE rende
/// idempotente la pianificazione anche con più worker concorrenti.
model ReminderEvent {
  id               String              @id @default(uuid(7)) @db.Uuid
  dedupeKey        String              @unique
  target           ReminderTarget
  resourceId       String              @db.Uuid
  deadlineRevision Int
  ruleId           String              @db.Uuid
  occurrence       Int                 @default(0)
  channel          NotificationChannel
  scheduledFor     DateTime            @db.Timestamptz(3)
  status           ReminderEventStatus @default(PENDING)
  attempts         Int                 @default(0)
  lockedAt         DateTime?           @db.Timestamptz(3)
  lockedBy         String?
  processedAt      DateTime?           @db.Timestamptz(3)
  lastError        String?
  notificationId   String?             @db.Uuid
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)

  rule         ReminderRule  @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([status, scheduledFor])
  @@index([target, resourceId])
}

enum NotificationType {
  RENEWAL_UPCOMING
  RENEWAL_DUE
  RENEWAL_OVERDUE
  RECEIVABLE_UPCOMING
  RECEIVABLE_DUE
  RECEIVABLE_OVERDUE
  SYSTEM
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

/// Notifica logica persistente (visibile in dashboard anche se il telefono è
/// offline). dedupeKey = "<tipo risorsa>:<id>:<revisione>:<regola>[:<occorrenza>]".
model Notification {
  id           String             @id @default(uuid(7)) @db.Uuid
  dedupeKey    String             @unique
  userId       String             @db.Uuid
  type         NotificationType
  title        String
  body         String
  /// Data dell'evento di riferimento (scadenza), data civile.
  eventDate    DateTime?          @db.Date
  scheduledFor DateTime           @db.Timestamptz(3)
  clientId     String?            @db.Uuid
  serviceId    String?            @db.Uuid
  renewalId    String?            @db.Uuid
  receivableId String?            @db.Uuid
  amount       Decimal?           @db.Decimal(12, 2)
  link         String
  status       NotificationStatus @default(UNREAD)
  readAt       DateTime?          @db.Timestamptz(3)
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client     Client?                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  service    Service?               @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  renewal    ServiceRenewal?        @relation(fields: [renewalId], references: [id], onDelete: Restrict)
  receivable Receivable?            @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  deliveries NotificationDelivery[]
  events     ReminderEvent[]

  @@index([userId, status, createdAt])
}

model PushSubscription {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @db.Uuid
  endpoint      String    @unique
  p256dh        String
  auth          String
  label         String?
  userAgent     String?
  enabled       Boolean   @default(true)
  /// Valorizzato quando il push service risponde 404/410: la sottoscrizione non è più valida.
  revokedAt     DateTime? @db.Timestamptz(3)
  lastSuccessAt DateTime? @db.Timestamptz(3)
  failureCount  Int       @default(0)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId])
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  GAVE_UP
  CANCELLED
}

/// Consegna push di una notifica a un dispositivo. UNIQUE(notification, subscription):
/// i retry aggiornano la stessa riga, non creano nuove consegne.
model NotificationDelivery {
  id             String         @id @default(uuid(7)) @db.Uuid
  notificationId String         @db.Uuid
  subscriptionId String         @db.Uuid
  status         DeliveryStatus @default(PENDING)
  attempts       Int            @default(0)
  nextAttemptAt  DateTime       @default(now()) @db.Timestamptz(3)
  lockedAt       DateTime?      @db.Timestamptz(3)
  lockedBy       String?
  sentAt         DateTime?      @db.Timestamptz(3)
  lastError      String?
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  notification Notification                  @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  subscription PushSubscription              @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  attemptLogs  NotificationDeliveryAttempt[]

  @@unique([notificationId, subscriptionId])
  @@index([status, nextAttemptAt])
}

model NotificationDeliveryAttempt {
  id         BigInt   @id @default(autoincrement())
  deliveryId String   @db.Uuid
  attemptNo  Int
  success    Boolean
  statusCode Int?
  error      String?
  durationMs Int?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  delivery NotificationDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
}

model WorkerHeartbeat {
  workerId  String   @id
  hostname  String
  pid       Int
  startedAt DateTime @db.Timestamptz(3)
  lastSeen  DateTime @db.Timestamptz(3)
}

// ─────────────────────────────── Documenti ───────────────────────────────

enum DocumentKind {
  RECEIPT
  INVOICE
  CONTRACT
  TECH_REPORT
  QUOTE
  OTHER
}

/// File privato. storageKey è un nome interno generato dal sistema; il file
/// è servito solo tramite route autenticata, mai da URL pubblico.
model Document {
  id           String       @id @default(uuid(7)) @db.Uuid
  storageKey   String       @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  sha256       String
  kind         DocumentKind @default(OTHER)
  description  String?
  clientId     String?      @db.Uuid
  serviceId    String?      @db.Uuid
  renewalId    String?      @db.Uuid
  projectId    String?      @db.Uuid
  receivableId String?      @db.Uuid
  payableId    String?      @db.Uuid
  paymentId    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)

  client     Client?         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  service    Service?        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  renewal    ServiceRenewal? @relation(fields: [renewalId], references: [id], onDelete: Restrict)
  project    Project?        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  receivable Receivable?     @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  payable    Payable?        @relation(fields: [payableId], references: [id], onDelete: Restrict)
  payment    Payment?        @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([clientId])
  @@index([serviceId])
}
